FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
COPY emp_pjs/requirements.txt emp_pjs/requirements.txt
COPY model_pjs/requirements.txt model_pjs/requirements.txt
RUN pip install --no-cache-dir -r emp_pjs/requirements.txt
COPY . /app
RUN mkdir -p /tmp/uploads
ENV COMPANY_DATABASE_PATH=/tmp/company.db UPLOAD_FOLDER=/tmp/uploads
CMD ["sh", "-c", "gunicorn --chdir emp_pjs --bind 0.0.0.0:${PORT} --workers 1 --threads 4 --timeout 120 app:app"]
