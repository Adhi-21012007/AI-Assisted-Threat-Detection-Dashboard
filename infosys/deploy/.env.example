# Copy values into Cloud Run / Secret Manager; never commit a real secret.
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
SECURITY_API_KEY=replace-with-a-separate-random-api-key
# Cloud Run demo only. Production requires Cloud SQL migration.
COMPANY_DATABASE_PATH=/tmp/company.db
UPLOAD_FOLDER=/tmp/uploads
# Future Cloud SQL migration (not used by the SQLite local runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
CLOUD_SQL_INSTANCE=PROJECT:REGION:INSTANCE
# Optional GCP integration seams; unset values keep local synchronous/storage mode.
GCP_PROJECT_ID=your-project-id
GCP_PUBSUB_TOPIC=projects/your-project-id/topics/security-events
GCP_STORAGE_BUCKET=your-security-evidence-bucket
BIGQUERY_DATASET=security_analytics
GOOGLE_CLOUD_PROJECT=your-project-id
